{{>layouts/header}}

<div class="mb-4">
    <a href="/articles" class="btn-back">&larr; Back to list</a>
</div>

<div class="card p-4 mb-4">
    {{#article}}
    <h2 class="page-title">{{title}}</h2>
    <hr>
    <p style="color: #4a5568; line-height: 1.8; white-space: pre-wrap;">{{content}}</p>
    <hr>
    <div class="d-flex gap-2">
        <a href="/articles/{{id}}/edit" class="btn btn-primary">Edit</a>
        <a href="/articles/{{id}}/delete" class="btn btn-danger">Delete</a>
    </div>
    {{/article}}
</div>

{{>comments/_comments}}

{{>layouts/footer}}