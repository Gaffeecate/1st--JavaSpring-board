{{>layouts/header}}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title mb-0">All Posts</h2>
    <a href="/articles/new" class="btn-new">+ New Post</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th scope="col" style="width: 60px;">#</th>
                <th scope="col">Title</th>
                <th scope="col">Content</th>
            </tr>
            </thead>
            <tbody>
            {{#articleList}}
                <tr>
                    <td class="text-muted">{{id}}</td>
                    <td><a href="/articles/{{id}}" class="article-link">{{title}}</a></td>
                    <td class="text-muted">{{content}}</td>
                </tr>
            {{/articleList}}
            {{^articleList}}
                <tr>
                    <td colspan="3" class="text-center text-muted py-5">No posts yet.</td>
                </tr>
            {{/articleList}}
            </tbody>
        </table>
    </div>
</div>

{{>layouts/footer}}