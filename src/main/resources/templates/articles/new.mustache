{{>layouts/header}}

<div class="mb-4">
    <a href="/articles" class="btn-back">&larr; Back to list</a>
</div>

<h2 class="page-title">New Post</h2>

<div class="card p-4">
    <form action="/articles/create" method="post">
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" class="form-control" name="title" placeholder="Enter title">
        </div>
        <div class="mb-3">
            <label class="form-label">Content</label>
            <textarea class="form-control" rows="6" name="content" placeholder="Enter content"></textarea>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit</button>
            <a href="/articles" class="btn-back d-flex align-items-center">Cancel</a>
        </div>
    </form>
</div>

{{>layouts/footer}}